# pnpm configuration for the frontend workspace (Requirement 16.7).
#
# These settings make version drift and accidental supply-chain surprises fail
# loudly instead of resolving silently.

# Refuse to install if package.json and pnpm-lock.yaml disagree. CI relies on
# this; keeping it here means local installs behave the same way.
frozen-lockfile=true

# Save exact versions. Never write a caret/tilde range into package.json.
save-exact=true

# Do not silently run install scripts from transitive dependencies. Any package
# that needs a build step must be added to the allowlist deliberately during
# dependency review (see docs/dependency-review.md).
ignore-scripts=true

# Fail rather than auto-installing a different pnpm/node than the pinned one.
engine-strict=true
package-manager-strict=true
